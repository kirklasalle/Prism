{
    "name": "prism-core",
    "version": "0.23.1",
    "private": true,
    "type": "module",
    "scripts": {
        "prebuild": "node scripts/compute-directive-hash.cjs",
        "prebuild:hash-pad": "node scripts/compute-directive-hash.cjs",
        "keys:generate-plugin": "node scripts/generate-plugin-key.cjs",
        "keys:validate": "node scripts/validate-plugin-keys.cjs",
        "backup": "npm run build && node scripts/prism-backup.cjs",
        "restore": "npm run build && node scripts/prism-restore.cjs",
        "update": "node scripts/prism-update.cjs",
        "ptac:sandbox": "npm run build && node dist/src/ptac/cli.js --profile=sandbox",
        "ptac:host": "npm run build && node dist/src/ptac/cli.js --profile=host",
        "ptac:demo": "npm run build && node dist/src/ptac/cli.js --profile=sandbox --suite=demo",
        "ptac:fast": "npm run build && node dist/src/ptac/cli.js --profile=sandbox --suite=fast",
        "ptac:full": "npm run build && node dist/src/ptac/cli.js --profile=sandbox --suite=full",
        "ptac:ci": "npm run build && node dist/src/ptac/cli.js --profile=sandbox --suite=fast",
        "ptac:demo-recording": "npm run build && node dist/src/ptac/cli.js --profile=sandbox --suite=demo --demo-recording",
        "ptac:osworld": "npm run build && node dist/src/ptac/cli.js --profile=host --suite=osworld",
        "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/core/operator/public','dist/src/core/operator/public',{recursive:true}); require('fs').cpSync('src/core/operator/scripts','dist/src/core/operator/scripts',{recursive:true})\"",
        "start": "node dist/src/index.js",
        "start:server": "set PRISM_MODE=server&& node dist/src/index.js",
        "dev": "tsx src/index.ts",
        "start:tui": "tsx src/tui/app.tsx",
        "dev:tui": "tsx src/tui/app.tsx",
        "test:web-creator": "npm run build && node --test dist/tests/prism-web-creator.test.js",
        "test:shell-destructive": "npm run build && node --test --test-force-exit dist/tests/shell-tool-destructive.test.js",
        "test:migrations": "npm run build && node --test --test-force-exit dist/tests/db-migration-framework.test.js",
        "test:db-manager": "npm run build && node --test --test-force-exit dist/tests/db-manager.test.js",
        "test:discover": "node scripts/run-discovered-tests.cjs",
        "test:discover:list": "node scripts/run-discovered-tests.cjs --list",
        "test:coverage": "set SKIP_TUI_E2E=1&& npm run build && nyc --reporter=text-summary --reporter=json-summary --exclude='.mcp/**' --exclude='dist/tests/e2e/**' node scripts/run-discovered-tests.cjs --no-build",
        "test:coverage:check": "node scripts/coverage-floor-gate.cjs",
        "test:coverage:gate": "npm run test:coverage && node scripts/coverage-floor-gate.cjs --require-floor",
        "test": "npm run test:discover",
        "perf:qualify": "npm run build && node dist/src/benchmarks/performance-qualification.js",
        "perf:qualify:dev": "set PRISM_ENV_PROFILE=dev&& npm run perf:qualify",
        "perf:qualify:staging": "set PRISM_ENV_PROFILE=staging&& npm run perf:qualify",
        "perf:qualify:prod": "set PRISM_ENV_PROFILE=prod&& npm run perf:qualify",
        "perf:trend-report": "node scripts/perf-trend-report.cjs",
        "perf:trend-gate": "set PRISM_PERF_GATE=strict&& node scripts/perf-trend-report.cjs",
        "soak:smoke": "node scripts/soak-harness.cjs",
        "soak:staging": "set PRISM_SOAK_DURATION_MS=259200000&& node scripts/soak-harness.cjs",
        "stress:concurrent": "node scripts/stress-concurrent-sessions.cjs",
        "release:sign-artifact": "node scripts/sign-release-artifact.cjs",
        "release:verify-artifact": "node scripts/verify-release-artifact.cjs",
        "security:owasp": "node scripts/owasp-scan.cjs",
        "security:directive-sign": "node scripts/sign-directive-file.cjs",
        "security:secrets": "node scripts/secrets-scan.cjs",
        "security:directive-integrity": "node scripts/directive-integrity-gate.cjs",
        "security:verify-audit-chain": "node scripts/verify-audit-chain.cjs",
        "governance:status:generate": "tsx src/core/governance/governance-status.ts",
        "governance:status:check": "tsx src/core/governance/governance-status.ts --check",
        "governance:artifacts:generate": "tsx src/core/governance/governance-artifact-manifest.ts",
        "governance:artifacts:check": "tsx src/core/governance/governance-artifact-manifest.ts --check",
        "governance:erratum:status": "node scripts/governance-erratum-update.cjs status",
        "governance:erratum:check": "node scripts/governance-erratum-update.cjs check",
        "governance:erratum:locate-base": "node scripts/governance-erratum-update.cjs locate-base",
        "governance:erratum:restore-base": "node scripts/governance-erratum-update.cjs restore-base",
        "governance:erratum:apply": "node scripts/governance-erratum-update.cjs apply",
        "governance:erratum:rotate-apply": "node scripts/governance-erratum-update.cjs rotate-apply",
        "governance:erratum:effectuate": "node scripts/governance-erratum-update.cjs effectuate",
        "governance:key-rotation:verify": "node scripts/verify-governance-key-rotation.cjs",
        "governance:probes:run": "node dist/src/core/governance/probe-runner.js",
        "governance:probes": "npm run build && npm run governance:probes:run",
        "security:sbom-cve-gate": "node scripts/sbom-cve-gate.cjs",
        "security:sbom": "node scripts/sbom-cve-gate.cjs",
        "audit:platform-parity": "node scripts/platform-parity-audit.cjs",
        "plugin:scaffold": "node scripts/scaffold-plugin.cjs",
        "demo:sr-showcase": "node examples/sr-showcase/run-demo.cjs",
        "docs:build": "node scripts/docs-build.cjs",
        "e1:qualify": "npm run build && node dist/src/benchmarks/e1-individual-qualification.js",
        "e2:qualify": "npm run build && node dist/src/benchmarks/e2-business-qualification.js",
        "e3:qualify": "npm run build && node dist/src/benchmarks/e3-policy-stress.js",
        "e4:qualify": "npm run build && node dist/src/benchmarks/e4-profile-switch-qualification.js",
        "e:qualify:stage2": "npm run build && node dist/src/benchmarks/e-stage2-qualification.js",
        "d1:qualify": "npm run build && node dist/src/benchmarks/d1-workflow-template-qualification.js",
        "g:trust:qualify": "npm run build && node ./node_modules/mocha/bin/mocha.js \"dist/tests/business-trust-validator.test.js\"",
        "g:trust:qualify:evidence": "npm run build && node dist/src/benchmarks/g-business-trust-qualification.js",
        "j:lineage:qualify": "npm run build && node dist/src/benchmarks/j-event-lineage-qualification.js && node ./node_modules/mocha/bin/mocha.js \"dist/tests/event-lineage-telemetry.test.js\"",
        "cu:bg:check": "npm run build && node dist/src/benchmarks/cu-bg-gate-check.js",
        "ci:gate:check": "npm run test:coverage:gate && npm run governance:status:check && npm run governance:artifacts:check && node dist/src/core/governance/probe-runner.js --allow-not-evaluated && npm run security:directive-integrity && npm run security:secrets && npm run security:sbom-cve-gate && node dist/src/benchmarks/ci-gate-check.js",
        "contracts:snapshot": "npm run build && node dist/src/benchmarks/tool-contract-snapshot.js",
        "release:validate": "npm run build && node dist/src/benchmarks/release-validation.js",
        "release:validate:strict": "npm run build && node dist/src/core/governance/probe-runner.js --allow-not-evaluated && node dist/src/benchmarks/release-validation.js --strict",
        "prism:selftest:public": "node scripts/prism-selftest-public.cjs",
        "release:generate-packet": "node scripts/generate-release-packet.cjs",
        "release:contract-diff-gate": "node scripts/contract-diff-gate.cjs",
        "release:contract-diff-gate:allow-breaking": "node scripts/contract-diff-gate.cjs --allow-breaking",
        "test:tui": "npm run build && node --test --test-force-exit dist/tests/tui-unit.test.js && node --test --test-force-exit dist/tests/tui-components.test.js && node --test --test-force-exit dist/tests/tui-hooks.test.js && node --test --test-force-exit dist/tests/tui-tab-chat.test.js && node --test --test-force-exit dist/tests/tui-tab-settings.test.js && node --test --test-force-exit dist/tests/tui-tab-tools.test.js && node --test --test-force-exit dist/tests/tui-tab-agentic.test.js && node --test --test-force-exit dist/tests/tui-tab-computer.test.js && node --test --test-force-exit dist/tests/tui-tab-browser.test.js && node --test --test-force-exit dist/tests/tui-tab-workspace.test.js && node --test --test-force-exit dist/tests/tui-tab-network.test.js && node --test --test-force-exit dist/tests/tui-tab-telemetry.test.js && node --test --test-force-exit dist/tests/tui-tab-logs.test.js && node --test --test-force-exit dist/tests/tui-tab-scheduler.test.js",
        "test:tui:e2e": "npm run build && node --test --test-force-exit dist/tests/tui-e2e.test.js",
        "test:e2e": "npm run build && node ./node_modules/mocha/bin/mocha.js --exit --timeout 180000 \"dist/tests/e2e/*.test.js\"",
        "demo:scenarios": "node scripts/run-demo-scenarios.cjs --profile=all",
        "demo:scenarios:individual": "set PRISM_EXECUTION_PROFILE=individual&& node scripts/run-demo-scenarios.cjs",
        "demo:scenarios:business": "set PRISM_EXECUTION_PROFILE=business&& node scripts/run-demo-scenarios.cjs",
        "pm2:start": "pm2 start ecosystem.config.js",
        "pm2:stop": "pm2 stop prism",
        "pm2:restart": "pm2 restart prism",
        "pm2:logs": "pm2 logs prism",
        "pm2:monit": "pm2 monit",
        "docker:build": "docker build -t prism .",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down",
        "setup": "tsx src/cli/setup-wizard.ts",
        "setup:advanced": "tsx src/cli/setup-wizard.ts --advanced",
        "doctor": "node scripts/prism-doctor.cjs",
        "doctor:json": "node scripts/prism-doctor.cjs --json",
        "governance:verify-signature": "node scripts/verify-governance-signature.cjs",
        "governance:verify-signature:strict": "node scripts/verify-governance-signature.cjs --strict",
        "build:watch": "tsc --noEmit --watch",
        "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
        "format": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
        "format:fix": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
        "prepare": "node -e \"if (require('fs').existsSync('.git')) require('child_process').execSync('husky')\""
    },
    "dependencies": {
        "@types/react": "^18.3.28",
        "gray-matter": "^4.0.3",
        "ink": "^5.2.1",
        "ink-select-input": "^6.2.0",
        "ink-spinner": "^5.0.0",
        "ink-text-input": "^6.0.0",
        "googleapis": "^173.0.0",
        "markdown-it": "^14.3.0",
        "markdown-it-anchor": "^9.0.1",
        "playwright": "^1.58.2",
        "react": "^18.3.1",
        "sharp": "^0.35.3",
        "sqlite3": "^6.0.1",
        "uuid": "^14.0.1",
        "ws": "^8.21.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@types/jsdom": "^28.0.1",
        "@types/markdown-it": "^13.0.1",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.0.0",
        "@types/ws": "^8.18.1",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "eslint": "^9.21.0",
        "typescript-eslint": "^8.24.0",
        "fast-check": "^4.6.0",
        "husky": "^9.0.0",
        "ink-testing-library": "^4.0.0",
        "jsdom": "^29.0.2",
        "lint-staged": "^17.0.7",
        "markdownlint-cli2": "^0.23.1",
        "mocha": "^11.7.6",
        "nyc": "^18.0.0",
        "prettier": "^3.8.4",
        "tsx": "^4.19.0",
        "typescript": "^5.8.0"
    },
    "lint-staged": {
        "src/**/*.ts": [
            "prettier --check",
            "eslint --fix"
        ],
        "*.md": [
            "markdownlint-cli2 --fix"
        ]
    },
    "optionalDependencies": {
        "@azure/msal-node": "^5.4.2",
        "@types/dockerode": "^4.0.1",
        "@types/node-pty": "npm:null@*",
        "dockerode": "^5.0.1",
        "node-pty": "^1.1.0"
    },
    "overrides": {
        "@grpc/grpc-js": "^1.14.4",
        "brace-expansion": "^5.0.9",
        "diff": "^9.0.0",
        "esbuild": "^0.28.1",
        "glob": "^13.0.0",
        "gray-matter": {
            "js-yaml": "^3.15.1"
        },
        "ip-address": "^10.3.1",
        "js-yaml": "^4.3.1",
        "protobufjs": "^7.6.3",
        "qs": "^6.15.3",
        "serialize-javascript": "^7.0.5",
        "tar": "^7.5.22",
        "undici": "^7.28.0",
        "uuid": "^14.0.1",
        "ws": "^8.21.0"
    },
    "allowScripts": {
        "cpu-features@0.0.10": true,
        "esbuild@0.28.1": true,
        "node-pty@1.1.0": true,
        "protobufjs@7.6.5": true,
        "sharp@0.35.3": true,
        "sqlite3@6.0.1": true,
        "ssh2@1.17.0": true
    }
}